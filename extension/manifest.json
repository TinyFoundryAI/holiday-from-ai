{
  "manifest_version": 3,
  "name": "Holiday from AI",
  "version": "0.4.0",
  "description": "Replaces all AI-related content on LinkedIn with garden-themed haikus",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["src/replacement-engine.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://*.linkedin.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["themes/analog-life.json", "haikus.json", "images/*.jpg", "audio/*.mp3"],
      "matches": ["https://*.linkedin.com/*"]
    }
  ]
}
